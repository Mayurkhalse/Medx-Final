# Med-X Server Central Configuration
# NODE_ENV: development | production | test
NODE_ENV=development

# Server Port
PORT=5000

# Persistent MongoDB Connection (Required - No In-Memory Runtime Fallback)
MONGODB_URI=mongodb://localhost:27017/medx_unified

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Machine Learning Service Boundary
ML_SERVICE_URL=http://127.0.0.1:8000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Google OAuth (Required only if Google Auth enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
